PORT=3000
BCRYPT_SALT_ROUNDS=10

# Browser origins allowed to call the API (comma-separated, scheme + host + port).
CORS_ORIGINS=https://coffeecat45.github.io,http://localhost:5173,http://127.0.0.1:5173

# Session lifetime in days and auth rate limits.
SESSION_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MIN=60

# Preferred for Supabase / Neon / managed PostgreSQL.
# For Supabase use the transaction pooler URL (usually port 6543), not session mode 5432.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DBNAME?sslmode=require

# Optional pg pool size override. For managed poolers/session mode use a low value such as 1.
PGPOOLMAX=1

# Fallback local PostgreSQL settings if DATABASE_URL is not set
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=b2b_market

# DaData (optional): key stays on the server only, never in the frontend bundle.
# Without a key the API returns { available: false, reason: "not_configured" } and manual input keeps working.
# Do not send or log personal data: only INN queries and sanitized company requisites.
DADATA_API_KEY=
DADATA_TIMEOUT_MS=5000


